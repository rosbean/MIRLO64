# Tests for MIRLO's MIPS SoC, run in sim/mips_soc (tb_soc build/<test>.bin).
TESTS := cpu_test int64_test libc_test n64win_test rsp_replay psram_test zburst_test vwin_test hires_test mon_test mi_test vi_test ai_test rcpcpu_test si_test viaa_test pi2_test tlbmon_test tlbgame_test ram8_test tlbpg_test tlbreal_test padtest
all: $(TESTS)
$(TESTS):
	$(MAKE) -f test.mk PROGRAM=$@ OBJECTS=build/$@.o
clean:
	rm -rf build
.PHONY: all clean $(TESTS)
